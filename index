  copyEl.addEventListener("click",function(){var btn=this;try{navigator.clipboard.writeText(curHex).then(function(){btn.textContent="¡Copiado!";setTimeout(function(){btn.textContent="Copiar";},1200);});}catch(e){btn.textContent="Cópialo manual";}});
  window.LAB_toObj=function(hex){document.querySelectorAll("[data-obj]").forEach(function(x){x.classList.remove('on');});loadHex(hex,"Color creado por ti en el Probador de impacto.",null);};
  document.querySelector("[data-obj='cta']").classList.add('on');loadHex(obj.cta.hex,obj.cta.desc,obj.cta.accent);
})();
 
/* ===== PROBADOR DE IMPACTO ===== */
(function(){
  var colorEl=document.getElementById("tColor"),hexEl=document.getElementById("tHex");
  var hue=document.getElementById("tHue"),sat=document.getElementById("tSat"),lum2=document.getElementById("tLum");
  var bg="#FFFFFF",lastHex="#137DC5";
  function paintPreview(hex){var t=bestText(hex);document.getElementById("p4cta").style.background=hex;document.getElementById("p4cta").style.color=t.color;
    document.getElementById("p4logo").style.background=hex;document.getElementById("p4tag").style.background=hex;document.getElementById("p4tag").style.color=t.color;}
  function evalColor(hex){hex=hex.toUpperCase();lastHex=hex;paintPreview(hex);
    var a=attention(hex,bg);
    document.getElementById("mAtt").textContent=a.score;
    document.getElementById("mWarm").textContent=a.warmth>0.6?"Cálido":a.warmth<0.4?"Frío":"Neutro";
    document.getElementById("mSat").textContent=Math.round(a.sat*100)+"%";
    var cbg=cr(hex,bg),cw=cr(hex,"#FFFFFF"),t=bestText(hex);
    document.getElementById("mCbg").textContent=cbg.toFixed(1)+" : 1";
    document.getElementById("mCw").textContent=cw.toFixed(1)+" : 1";
    var passAA=t.ratio>=4.5,passAAA=t.ratio>=7,v=document.getElementById("mVerdict");
    v.textContent=passAAA?"Excelente":passAA?"Aprobado AA":"Bajo contraste";v.style.color=passAA?"#1D9E73":"#D85A30";
    var tip="Texto recomendado: "+(t.color==="#FFFFFF"?"blanco":"oscuro")+" (contraste "+t.ratio.toFixed(1)+":1). ";
    tip+=a.score>=66?"Alto poder de atención: úsalo como acento o CTA, no como fondo extenso.":a.score>=40?"Activación media: buen color secundario o de apoyo.":"Color tranquilo: ideal para fondos amplios y lectura, poco competitivo por la mirada.";
    if(cbg<3)tip+=" Ojo: contrasta poco con este fondo; cambia su luminosidad o el fondo.";
    document.getElementById("mTip").textContent=tip;renderUses("pUses",hex,bg);}
  function fromSliders(){var hex=hslToHex(+hue.value,sat.value/100,lum2.value/100);colorEl.value=hex;hexEl.value=hex;evalColor(hex);}
  function setSlidersFromHex(hex){var hsl=rgbToHsl.apply(null,hexToRgb(hex));hue.value=Math.round(hsl[0]);sat.value=Math.round(hsl[1]*100);lum2.value=Math.round(hsl[2]*100);}
  function fromHex(v){if(v.charAt(0)!=="#")v="#"+v;if(!isHex(v))return;v=v.toUpperCase();colorEl.value=v;hexEl.value=v;setSlidersFromHex(v);evalColor(v);}
  hue.addEventListener("input",fromSliders);sat.addEventListener("input",fromSliders);lum2.addEventListener("input",fromSliders);
  colorEl.addEventListener("input",function(){fromHex(colorEl.value);});
  hexEl.addEventListener("input",function(){fromHex(hexEl.value);});
  document.querySelectorAll("[data-bg]").forEach(function(b){b.addEventListener("click",function(){
    document.querySelectorAll("[data-bg]").forEach(function(x){x.classList.remove('on');});b.classList.add('on');
    var dark=b.dataset.bg==="dark";bg=dark?"#16203A":"#FFFFFF";
    document.getElementById("p4body").classList.toggle("darkbg",dark);evalColor(lastHex);});});
  document.getElementById("tMax").addEventListener("click",function(){
    sat.value=100;var h=+hue.value,best=0,bestL=0.5;
    for(var L=5;L<=95;L+=2){var hex=hslToHex(h,1,L/100);var sc=attention(hex,bg).score;if(sc>best){best=sc;bestL=L;}}
    lum2.value=bestL;fromSliders();});
  document.getElementById("tCopy").addEventListener("click",function(){var btn=this;try{navigator.clipboard.writeText(lastHex).then(function(){btn.textContent="¡Copiado!";setTimeout(function(){btn.textContent="Copiar HEX";},1200);});}catch(e){btn.textContent="Cópialo manual";}});
  document.getElementById("tToObj").addEventListener("click",function(){if(window.LAB_toObj)window.LAB_toObj(lastHex);goTab("obj");});
  document.getElementById("tToDash").addEventListener("click",function(){if(window.LAB_setDash)window.LAB_setDash(lastHex);goTab("dash");});
  fromSliders();
})();
</script>
</body>
